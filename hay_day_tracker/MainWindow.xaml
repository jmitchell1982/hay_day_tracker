<Window x:Class="HayDayPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hay Day Planner" Height="800" Width="1000">
    <TabControl>
        <TabItem Header="Farm Overview">
            <ContentControl x:Name="FarmOverviewContent" />
        </TabItem>
        <TabItem Header="Buildings">
            <ContentControl x:Name="BuildingsContent" />
        </TabItem>
        <TabItem Header="Products">
            <ContentControl x:Name="ProductsContent" />
        </TabItem>
        <TabItem Header="Upgrades">
            <ContentControl x:Name="UpgradesContent"></ContentControl>
        </TabItem>
        <TabItem Header="Shopping List">
            <ContentControl x:Name="ShoppingListContent"></ContentControl>
        </TabItem>
        <TabItem Header="Schedule">
            <ContentControl x:Name="ScheduleContent"></ContentControl>
        </TabItem>
    </TabControl>
</Window>
