<UserControl x:Class="HayDayPlanner.Views.FarmOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Farm Level" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                 Text="{Binding FarmLevel, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Current XP" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                 Text="{Binding CurrentXp, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="XP Needed for Next Level" VerticalAlignment="Center" Margin="0,4" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="Bold"
                   Text="{Binding XpNeededForNextLevel, Mode=OneWay}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Silo Capacity" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                 Text="{Binding SiloCapacity, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Barn Capacity" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                 Text="{Binding BarnCapacity, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tackle Box Capacity" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4"
                 Text="{Binding TackleBoxCapacity, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
