<UserControl x:Class="HayDayPlanner.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HayDayPlanner.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:HayDayPlanner.Services"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type services:ChainNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" />
                <TextBlock Text=" x" />
                <TextBlock Text="{Binding TotalQuantityNeeded}" />
                <TextBlock Text="  —  " Foreground="Gray" />
                <TextBlock Text="{Binding EffectiveTimePerUnitMinutes}" />
                <TextBlock Text=" min/unit, " Foreground="Gray" />
                <TextBlock Text="{Binding TimeContributionMinutes, StringFormat={}{0:0.#}}" />
                <TextBlock Text=" min total" Foreground="Gray" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left: filter + grid -->
        <DockPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Machine:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding MachineFilterOptions}"
                          SelectedItem="{Binding SelectedMachineFilter}"
                          Width="160" Margin="0, 0, 8, 0"/>
                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0 , 0, 8, 0" />
                <TextBox Text="{Binding LevelFilter}" Width="70"></TextBox>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="130" />
                    <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="100" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"></DataGridTextColumn>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=F2}" Width="70" />
                    <DataGridTextColumn Header="Ingr. Value" Binding="{Binding IngredientValue, StringFormat=N0}" Width="90" />
                    <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=F2}" Width="70" />
                    <DataGridTextColumn Header="Time (min)" Binding="{Binding EffectiveTimeMinutes}" Width="90" />
                    <DataGridTextColumn Header="Profit/Min" Binding="{Binding ProfitPerMinute, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="XP/Cycle" Binding="{Binding XpPerUnit, StringFormat=N0}" Width="70" />
                    <DataGridTextColumn Header="XP/Min" Binding="{Binding XpPerMinute, StringFormat=N2}" Width="80" />
                    <DataGridTextColumn Header="Value/XP" Binding="{Binding ValuePerXp, StringFormat=N1}" Width="80" />
                    <DataGridTextColumn Header="Profit/XP" Binding="{Binding ProfitPerXp, StringFormat=N1}" Width="80" />
                    <DataGridTextColumn Header="Max/Day" Binding="{Binding MaxUnitsPerDay, StringFormat=N0}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: detail panel for the selected product -->
        <DockPanel Grid.Column="2" DataContext="{Binding Detail}">
            <TextBlock Text="Ingredient Chain" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,4" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Bottleneck" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding BottleneckDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="Raw Materials Needed (per unit)" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding RawMaterials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding (vm:RawMaterialRow.Name), Mode=OneWay}" />
                                <Run Text=" x" />
                                <Run Text="{Binding (vm:RawMaterialRow.TotalQuantity), Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TreeView ItemsSource="{Binding RootNodes}" />
        </DockPanel>
    </Grid>
</UserControl>
