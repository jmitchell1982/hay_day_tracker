<UserControl x:Class="HayDayPlanner.Views.ShoppingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">

    <DataGrid ItemsSource="{Binding Items}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              Margin="16">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="150" />
            <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="80" />
            <DataGridTextColumn Header="Needed" Binding="{Binding TotalAmountNeeded}" IsReadOnly="True" Width="70" />
            <DataGridTextColumn Header="Have" Binding="{Binding Have, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            <DataGridTextColumn Header="Deficit" Binding="{Binding Deficit}" IsReadOnly="True" Width="70" />
            <DataGridTextColumn Header="Price/Unit" Binding="{Binding PricePerUnit, StringFormat=N0, TargetNullValue='—'}" Width="90" />
            <DataGridTextColumn Header="Cost per 10" Binding="{Binding CostForStackOf10, StringFormat=N0, TargetNullValue='—'}" Width="100" />
            <DataGridTextColumn Header="Priority Score" Binding="{Binding PriorityScore, StringFormat=N0}" Width="110" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
